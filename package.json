{
  "name": "memo-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal reading library: save links and text from mobile or PC, organized automatically by an LLM.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch backend/index.mjs",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && vite build --config vite.sw.config.ts",
    "start": "node backend/index.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "lucide-react": "latest",
    "puppeteer-core": "^25.13.0",
    "react": "latest",
    "react-dom": "latest",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "fake-indexeddb": "^6.2.5",
    "typescript": "latest",
    "vite": "latest"
  }
}
