# Backend API port (the Vite dev server proxies /api here).
# Allocated in C:\Claude\PORTS.md - 4313 for the backend, 5182 for the Vite dev frontend.
PORT=4313

# Where settings and sync bookkeeping live. Leave empty to use the project's own data folder.
DATA_DIR=

# The folder that holds the saved notes, filed by category as "<category>\<title> (<id>).md".
# It is a ready-to-use Obsidian vault: open it with "Open folder as vault", or point this at a
# folder inside an existing vault. Leave empty to use {DATA_DIR}\vault_output.
VAULT_DIR=

# Optional fallback for the LLM API key. The Settings screen is the normal place to set it.
LLM_API_KEY=
